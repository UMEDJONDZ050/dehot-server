# ── Маълумоти база (Neon / Render Postgres) ──────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dehot_db?schema=public&sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET="дар production як рамзи нави тасодуфӣ гузор"
JWT_EXPIRES_IN="30d"
ADMIN_SECRET="дар production як рамзи нави тасодуфӣ гузор"

# ── AI ────────────────────────────────────────────────────────────────────
YOLO_API_KEY=""
GROQ_API_KEY=""

# ── Cloudflare R2 (файлҳо: аксҳои маҳсулот, баннерҳо) ────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="dehot-uploads"
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# ── Firebase (push-нотификация) ──────────────────────────────────────────────
# Тамоми мазмуни firebase-service-account.json-ро ҳамчун як сатри JSON
FIREBASE_SERVICE_ACCOUNT=""

# ── Server ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
